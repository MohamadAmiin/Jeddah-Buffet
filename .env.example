# The RUNTIME role. It owns nothing: it cannot create, drop or truncate a table.
# The application connects only as this. Create it with:
#   bash scripts/db-bootstrap.sh <owner-password> <app-password>
DATABASE_URL=postgres://matcami_app:CHANGE_ME@localhost:5432/matcami

# The OWNER role. Used by drizzle-kit migrate, pg_dump and db:studio — everything
# that creates or reads the whole schema. Never point the application at this.
# The split is what lets row-level security be switched on later by one migration
# instead of a database re-bootstrap.
MIGRATE_DATABASE_URL=postgres://matcami:CHANGE_ME@localhost:5432/matcami

# Separate database used ONLY by the Vitest integration project, as the OWNER:
# the harness creates and truncates tables, which the runtime role must not do.
# The name MUST end in _test — the integration setup refuses to run otherwise.
TEST_DATABASE_URL=postgres://matcami:CHANGE_ME@localhost:5432/matcami_test

# The public origin, e.g. https://pos.example.com. adapter-node needs it for
# SvelteKit's CSRF origin check behind a proxy. NEVER disable the check instead.
#
# Left EMPTY on purpose: an operator who copies this file unchanged to production
# and gets `403 Cross-site POST form submissions are forbidden` on every login
# must be pushed toward setting this, not toward turning the check off.
# In production the app refuses to start unless it is set, https: and not
# localhost.
ORIGIN=

# Behind Nginx, without these every audit row records 127.0.0.1 and public
# sign-up's per-address throttle and daily cap treat all visitors as one client.
# In production the app refuses to start without ADDRESS_HEADER (a localhost
# ORIGIN only warns). Pair with
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
ADDRESS_HEADER=x-forwarded-for
XFF_DEPTH=1

# Public sign-up. Unset or `open`: anyone can create a company at /register, up
# to 3 per internet address per day. `closed`: /register refuses every sign-up —
# the brake for a bot wave (restart the app to apply). Any other value stops the
# app at boot. Extra companies can always be created with `pnpm restaurant:create`.
SIGNUP=open
