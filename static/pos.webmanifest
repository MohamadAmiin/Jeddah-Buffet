{
	"id": "/pos",
	"name": "matcami POS",
	"short_name": "matcami POS",
	"description": "The till: PIN sign-in, orders, payment and shifts. Works offline once installed.",
	"scope": "/pos",
	"start_url": "/pos",
	"display": "fullscreen",
