	"icons": [
		{ "src": "/pos-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
		{ "src": "/pos-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
		{
			"src": "/pos-icon-maskable-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		}
	]
}
